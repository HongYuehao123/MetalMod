# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Gradle
build/
.gradle/
out/

# Native build trees. scripts/build_mod.sh configures CMake into native/build;
# the glob also covers throwaway trees such as native/build-verify.
native/build/
native/build-*/

# CMake artefacts, in case it is ever configured in-tree under native/
native/CMakeCache.txt
native/CMakeFiles/
native/cmake_install.cmake
native/Makefile
CMakeUserPresets.json

# Compile-time API stubs generated by scripts/generate_stubs.py (under build/)
# and ad-hoc javac output (the README's original `javac -d bin`).
bin/

# ---------------------------------------------------------------------------
# Compiled binaries
# ---------------------------------------------------------------------------
# All of these are regenerated by scripts/build_mod.sh, which compiles the
# native library and packages the mod jar. Note: the `*.dylib` rule also covers
# src/main/resources/natives/libmetalmod.dylib - that copy is a build output
# that gets packaged into the jar, not a source file. Run the build script
# before packaging so the jar never ships a stale binary.
*.o
*.a
*.dylib
*.so
*.class
*.jar
*.dSYM/

# ---------------------------------------------------------------------------
# Runtime state written by the mod (MetalConfig.save())
# ---------------------------------------------------------------------------
config/metalmod.properties

# ---------------------------------------------------------------------------
# JVM crash dumps - native code can SIGSEGV, these must never be committed
# ---------------------------------------------------------------------------
hs_err_pid*.log
replay_pid*.log

# ---------------------------------------------------------------------------
# Editors, IDEs and OS files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
.DS_Store
